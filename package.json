{
    "name": "better-psl",
    "version": "1.0.1",
    "description": "Modern JavaScript domain name parser based on the Public Suffix List",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "update-rules": "node ./scripts/update-rules.ts",
        "build": "node ./scripts/rm-dist.ts && tsc",
        "ts:watch": "node ./scripts/rm-dist.ts && tsc --watch",
        "changelog": "git log $(git describe --tags --abbrev=0)..HEAD --oneline --format=\"%h %s (%an <%ae>)\""
    },
    "keywords": [
        "publicsuffix",
        "publicsuffixlist",
        "psl",
        "better-psl"
    ],
    "author": {
        "email": "mirasayon@ya.ru",
        "name": "Miralisher Agzamov",
        "url": "https://mirasayon.com/"
    },
    "funding": "https://github.com/sponsors/mirasayon",
    "license": "MIT",
    "dependencies": {
        "punycode": "^2.3.1"
    },
    "devDependencies": {
        "@types/node": "^25.2.3",
        "@types/punycode": "^2.1.4",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mirasayon/better-psl.git"
    },
    "engines": {
        "node": ">=20"
    }
}
