{
    "name": "better-psl",
    "version": "1.1.1",
    "description": "Modern JavaScript domain name parser based on the Public Suffix List",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "update-rules": "node ./scripts/update-rules.ts",
        "build": "tsc",
        "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck:watch": "tsc --watch --noEmit",
        "typecheck": "tsc --noEmit",
        "changelog": "git log $(git describe --tags --abbrev=0)..HEAD --oneline --format=\"%h %s (%an <%ae>)\""
    },
    "keywords": [
        "publicsuffix",
        "publicsuffixlist",
        "psl",
        "better-psl"
    ],
    "author": {
        "email": "mirasayon@ya.ru",
        "name": "Miralisher Agzamov",
        "url": "https://mirasayon.com/"
    },
    "funding": "https://github.com/sponsors/mirasayon",
    "license": "MIT",
    "dependencies": {
        "punycode": "^2.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/punycode": "^2.1.4",
        "typescript": "^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mirasayon/better-psl.git"
    },
    "engines": {
        "node": ">=20"
    }
}
